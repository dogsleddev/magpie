# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# For npm run db:types
SUPABASE_PROJECT_ID=your-project-id

# Krava privacy layer. When set, every AI call routes through Krava; unset = direct Anthropic.
KRAVA_APP_KEY=your-krava-app-key
# Optional; defaults to https://krava.io
KRAVA_BASE_URL=https://krava.io

# Service-role key for the Linq webhook (SERVER-ONLY, bypasses RLS). Supabase > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Linq iMessage front door (from the Linq rep)
LINQ_API_TOKEN=your-linq-api-token
LINQ_PHONE_NUMBER=+1XXXXXXXXXX
LINQ_WEBHOOK_SECRET=your-linq-webhook-signing-secret
